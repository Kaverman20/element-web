/*
 * Linear theme — minimalist 2026 product-tool aesthetic.
 *
 * Step 1: typography + palette only. No layout changes yet.
 *
 * Palette (true-to-Linear, slightly toned):
 *   Canvas (white):     #FFFFFF
 *   Surface subtle:     #FAFAFA  (sidebar/headers)
 *   Surface hover:      #F4F4F5  (rest of greys are zinc scale)
 *   Border subtle:      #E4E4E7
 *   Text primary:       #0A0A0A
 *   Text secondary:     #71717A
 *   Text tertiary:      #A1A1AA
 *   Accent (Linear):    #5E6AD2
 *   Accent hover:       #4F5BC2
 */

/* ── Compound design tokens ──────────────────────────────────────────────── */
/* Compound defines tokens under `.cpd-theme-light.cpd-theme-light` (doubled
   class for extra specificity). We must match or beat that selector — plain
   `:root` loses the cascade. */
.cpd-theme-light.cpd-theme-light,
:root {
    --cpd-color-bg-canvas-default: #ffffff;
    --cpd-color-bg-subtle-secondary: #fafafa;
    --cpd-color-bg-subtle-primary: #f4f4f5;

    --cpd-color-text-primary: #0a0a0a;
    --cpd-color-text-secondary: #71717a;

    --cpd-color-border-interactive-primary: #e4e4e7;

    /* ── Accent shift: Element's green scale → Linear purple ──
       Element binds $accent-N to --cpd-color-green-N, so overriding the
       whole green scale here repaints every accent surface in one shot
       (send button, selected room, bubbles, pills, verified indicators). */
    --cpd-color-green-100: #f3f4fb;
    --cpd-color-green-200: #e8eaf7;
    --cpd-color-green-300: #c8ceef;
    --cpd-color-green-400: #a4ade3;
    --cpd-color-green-500: #828dd7;
    --cpd-color-green-600: #5e6ad2;
    --cpd-color-green-700: #4f5bc2;
    --cpd-color-green-800: #4148a8;
    --cpd-color-green-900: #353b8c;
    --cpd-color-green-1000: #2a2e70;
    --cpd-color-green-1100: #232752;
    --cpd-color-green-1200: #1b1e40;
    --cpd-color-green-1300: #14172e;
    --cpd-color-green-1400: #0e101f;

    /* Compound accent tokens — point at the new purple */
    --cpd-color-text-action-accent: #5e6ad2;
    --cpd-color-icon-accent-primary: #5e6ad2;
    --cpd-color-icon-accent-tertiary: #5e6ad2;
    --cpd-color-bg-accent-rest: #5e6ad2;
    --cpd-color-bg-accent-hovered: #4f5bc2;
    --cpd-color-bg-accent-pressed: #4148a8;
    --cpd-color-bg-accent-subtle: rgba(94, 106, 210, 0.1);
    --cpd-color-bg-action-primary-rest: #5e6ad2;
    --cpd-color-bg-action-primary-hovered: #4f5bc2;
    --cpd-color-bg-action-primary-pressed: #4148a8;
}

/* ── Typography ──────────────────────────────────────────────────────────── */
/* Use system font stack with Inter as primary — Linear/Vercel approach.
   No serif anywhere. Slightly tighter letter-spacing on headings. */
html,
body {
    font-family:
        "Inter", "InterVariable", -apple-system, BlinkMacSystemFont,
        "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-feature-settings:
        "cv02", "cv03", "cv04", "cv11"; /* Inter stylistic tweaks */
}

/* Headings — tight tracking, like Linear */
h1, h2, h3, h4,
.mx_RoomHeader h1,
.mx_RoomHeader_nametext {
    letter-spacing: -0.015em !important;
    color: #0a0a0a !important;
}

/* Body text — slightly softer black for readability */
body,
.mx_EventTile_content,
.mx_EventTile_body {
    color: #18181b;
}

/* Senders — clear hierarchy via weight, not colour */
.mx_DisambiguatedProfile_displayName,
.mx_EventTile_senderDetails .mx_DisambiguatedProfile_displayName {
    color: #0a0a0a !important;
    font-weight: 600 !important;
}

/* Timestamps / secondary meta */
.mx_MessageTimestamp,
.mx_EventTile_timestamp {
    color: #a1a1aa !important;
    font-size: 11px !important;
    font-weight: 400 !important;
}

/* ── Selection ───────────────────────────────────────────────────────────── */
::selection {
    background-color: rgba(94, 106, 210, 0.18);
    color: #0a0a0a;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 2 — Сайдбар в Linear-стиле                                             */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Two-plane separation: sidebar slightly off-white, chat pure white ────── */
.mx_LeftPanel_newRoomList,
.mx_RoomListPanel,
.mx_LeftPanel_roomListWrapper {
    background-color: #fafafa !important;
}

/* Crisp 1px boundary between sidebar and chat (no shadow) */
.mx_RoomListPanel,
.mx_LeftPanel {
    border-right: 1px solid #e4e4e7 !important;
}

/* ── Search input — quiet, flat, square-ish ──────────────────────────────── */
.mx_RoomSearch {
    background-color: #ffffff !important;
    border: 1px solid #e4e4e7 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
    transition: border-color 0.12s ease;
}

.mx_RoomSearch:hover {
    border-color: #d4d4d8 !important;
}

.mx_RoomSearch:focus-within {
    border-color: #a1a1aa !important;
}

.mx_RoomSearch input::placeholder {
    color: #a1a1aa !important;
    font-weight: 400;
}

/* ── Room list items — denser, flat hover, no purple wash on selected ─────── */
/* Selectors target the new room list (RoomListItemView). */
[class*="RoomListItemView"] {
    border-radius: 6px !important;
    min-height: 32px !important;
    padding-top: 4px !important;
    padding-bottom: 4px !important;
    transition:
        background-color 0.1s ease,
        color 0.1s ease;
}

/* Hover — almost invisible warm grey */
[class*="RoomListItemView"]:hover {
    background-color: #f4f4f5 !important;
}

/* Selected — single full-width neutral fill. Wipe any inner accent layer so
   we don't see a purple pill nested inside the grey wrapper. */
[class*="RoomListItemView"][aria-selected="true"],
[class*="RoomListItemView"][data-selected="true"],
[class*="RoomListItemView"].mx_RoomListItemView_selected {
    background-color: #ececef !important;
}

/* Kill the inner accent-subtle background that Compound paints under the
   selected button — keeps our outer fill clean and edge-to-edge. */
[class*="RoomListItemView"][aria-selected="true"] *,
[class*="RoomListItemView"][data-selected="true"] *,
[class*="RoomListItemView"].mx_RoomListItemView_selected * {
    background-color: transparent !important;
}

/* Room title — 13.5px / 450 weight, tightened tracking */
[class*="RoomListItemView"] [class*="roomName"],
[class*="RoomListItemView"] [class*="name"],
[class*="RoomListItemView"] [class*="title"] {
    font-size: 13.5px !important;
    font-weight: 450 !important;
    letter-spacing: -0.005em;
    color: #18181b !important;
}

/* Unread rooms — name goes near-black + 600, the only visual emphasis */
[class*="RoomListItemView"][data-unread="true"] [class*="roomName"],
[class*="RoomListItemView"][data-unread="true"] [class*="name"],
[class*="RoomListItemView"][data-unread="true"] [class*="title"] {
    color: #0a0a0a !important;
    font-weight: 600 !important;
}

/* Last-message preview / secondary text — tiny and quiet */
[class*="RoomListItemView"] [class*="lastMessage"],
[class*="RoomListItemView"] [class*="subtitle"],
[class*="RoomListItemView"] [class*="preview"] {
    font-size: 12px !important;
    color: #71717a !important;
    font-weight: 400 !important;
}
