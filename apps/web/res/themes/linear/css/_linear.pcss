/* stylelint-disable no-duplicate-selectors --
 * Этот файл — пошаговый набор override'ов поверх дефолтной темы Element.
 * Дубликаты селекторов осознанные: каждый шаг редизайна добавлял свой
 * блок правок, разнесённый по разделам файла для читаемости истории.
 * Сливать в один блок небезопасно — порядок rules влияет на cascade.
 */
/*
 * Linear theme — minimalist 2026 product-tool aesthetic.
 *
 * Step 1: typography + palette only. No layout changes yet.
 *
 * Palette (true-to-Linear, slightly toned):
 *   Canvas (white):     #FFFFFF
 *   Surface subtle:     #FAFAFA  (sidebar/headers)
 *   Surface hover:      #F4F4F5  (rest of greys are zinc scale)
 *   Border subtle:      #E4E4E7
 *   Text primary:       #0A0A0A
 *   Text secondary:     #71717A
 *   Text tertiary:      #A1A1AA
 *   Accent (Linear):    #5E6AD2
 *   Accent hover:       #4F5BC2
 */

/* ── Compound design tokens ──────────────────────────────────────────────── */
/* Compound defines tokens under `.cpd-theme-light.cpd-theme-light` (doubled
   class for extra specificity). We must match or beat that selector — plain
   `:root` loses the cascade. */
.cpd-theme-light.cpd-theme-light,
:root {
    --cpd-color-bg-canvas-default: #ffffff;
    --cpd-color-bg-subtle-secondary: #fafafa;
    --cpd-color-bg-subtle-primary: #f4f4f5;
    --cpd-color-text-primary: #0a0a0a;
    --cpd-color-text-secondary: #71717a;
    --cpd-color-border-interactive-primary: #e4e4e7;

    /* ── Accent shift: Element's green scale → Linear purple ──
       Element binds $accent-N to --cpd-color-green-N, so overriding the
       whole green scale here repaints every accent surface in one shot
       (send button, selected room, bubbles, pills, verified indicators). */
    --cpd-color-green-100: #f3f4fb;
    --cpd-color-green-200: #e8eaf7;
    --cpd-color-green-300: #c8ceef;
    --cpd-color-green-400: #a4ade3;
    --cpd-color-green-500: #828dd7;
    --cpd-color-green-600: #5e6ad2;
    --cpd-color-green-700: #4f5bc2;
    --cpd-color-green-800: #4148a8;
    --cpd-color-green-900: #353b8c;
    --cpd-color-green-1000: #2a2e70;
    --cpd-color-green-1100: #232752;
    --cpd-color-green-1200: #1b1e40;
    --cpd-color-green-1300: #14172e;
    --cpd-color-green-1400: #0e101f;

    /* Compound accent tokens — point at the new purple */
    --cpd-color-text-action-accent: #5e6ad2;
    --cpd-color-icon-accent-primary: #5e6ad2;
    --cpd-color-icon-accent-tertiary: #5e6ad2;
    --cpd-color-bg-accent-rest: #5e6ad2;
    --cpd-color-bg-accent-hovered: #4f5bc2;
    --cpd-color-bg-accent-pressed: #4148a8;
    --cpd-color-bg-accent-subtle: rgb(94, 106, 210, 0.1);
    --cpd-color-bg-action-primary-rest: #5e6ad2;
    --cpd-color-bg-action-primary-hovered: #4f5bc2;
    --cpd-color-bg-action-primary-pressed: #4148a8;
}

/* ── Typography ──────────────────────────────────────────────────────────── */
/* Use system font stack with Inter as primary — Linear/Vercel approach.
   No serif anywhere. Slightly tighter letter-spacing on headings. */
html,
body {
    font-family:
        Inter, InterVariable, -apple-system, BlinkMacSystemFont,
        "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-feature-settings:
        "cv02", "cv03", "cv04", "cv11"; /* Inter stylistic tweaks */
}

/* Headings — tight tracking, like Linear */
h1, h2, h3, h4,
.mx_RoomHeader h1,
.mx_RoomHeader_nametext {
    letter-spacing: -0.015em !important;
    color: #0a0a0a !important;
}

/* Body text — slightly softer black for readability */
body,
.mx_EventTile_content,
.mx_EventTile_body {
    color: #18181b;
}

/* Senders — clear hierarchy via weight, not colour */
.mx_DisambiguatedProfile_displayName,
.mx_EventTile_senderDetails .mx_DisambiguatedProfile_displayName {
    color: #0a0a0a !important;
    font-weight: 600 !important;
}

/* Timestamps / secondary meta */
.mx_MessageTimestamp,
.mx_EventTile_timestamp {
    color: #a1a1aa !important;
    font-size: 11px !important;
    font-weight: 400 !important;
}

/* ── Selection ───────────────────────────────────────────────────────────── */
::selection {
    background-color: rgb(94, 106, 210, 0.18);
    color: #0a0a0a;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 2 — Сайдбар в Linear-стиле                                             */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Two-plane separation: sidebar slightly off-white, chat pure white ────── */
.mx_LeftPanel_newRoomList,
.mx_RoomListPanel,
.mx_LeftPanel_roomListWrapper {
    background-color: #fafafa !important;
}

/* Crisp 1px boundary between sidebar and chat (no shadow) */
.mx_RoomListPanel,
.mx_LeftPanel {
    border-right: 1px solid #e4e4e7 !important;
}

/* ── Search input — quiet, flat, square-ish ──────────────────────────────── */
.mx_RoomSearch {
    background-color: #ffffff !important;
    border: 1px solid #e4e4e7 !important;
    border-radius: 6px !important;
    box-shadow: none !important;
    transition: border-color 0.12s ease;
}

.mx_RoomSearch:hover {
    border-color: #d4d4d8 !important;
}

.mx_RoomSearch:focus-within {
    border-color: #a1a1aa !important;
}

.mx_RoomSearch input::placeholder {
    color: #a1a1aa !important;
    font-weight: 400;
}

/* ── Room list items — TG-стиль: крупные аватары + видимый разделитель ──── */
[class*="RoomListItemView"] {
    position: relative !important;
    border-radius: 0 !important;
    min-height: 68px !important;
    padding-top: 10px !important;
    padding-bottom: 10px !important;
    padding-left: 14px !important;
    padding-right: 14px !important;
    transition:
        background-color 0.1s ease,
        color 0.1s ease;
}

/* Тонкий разделитель — рисуем на ОБЁРТКЕ виртуализированного списка
   ([data-item-index]), потому что button внутри имеет свой layout и
   box-shadow на ней не видно между строками. */
[data-item-index] {
    box-shadow: inset 0 -1px 0 #e4e4e7;
}

/* Крупная аватарка как в TG */
[class*="RoomListItemView"] .mx_BaseAvatar,
[class*="RoomListItemView"] [class*="avatar"] img,
[class*="RoomListItemView"] [class*="Avatar"] {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    min-height: 48px !important;
    border-radius: 50% !important;
    font-size: 18px !important;
    line-height: 48px !important;
}

/* Hover — almost invisible warm grey */
[class*="RoomListItemView"]:hover {
    background-color: #f4f4f5 !important;
}

/* Selected — single full-width neutral fill. Wipe any inner accent layer so
   we don't see a purple pill nested inside the grey wrapper. */
[class*="RoomListItemView"][aria-selected="true"],
[class*="RoomListItemView"][data-selected="true"],
[class*="RoomListItemView"].mx_RoomListItemView_selected {
    background-color: #ececef !important;
}

/* Kill the inner accent-subtle background that Compound paints under the
   selected button — keeps our outer fill clean and edge-to-edge. */
[class*="RoomListItemView"][aria-selected="true"] *,
[class*="RoomListItemView"][data-selected="true"] *,
[class*="RoomListItemView"].mx_RoomListItemView_selected * {
    background-color: transparent !important;
}

/* Room title — 13.5px / 450 weight, tightened tracking */
[class*="RoomListItemView"] [class*="roomName"],
[class*="RoomListItemView"] [class*="name"],
[class*="RoomListItemView"] [class*="title"] {
    font-size: 13.5px !important;
    font-weight: 450 !important;
    letter-spacing: -0.005em;
    color: #18181b !important;
}

/* Unread rooms — name goes near-black + 600, the only visual emphasis */
[class*="RoomListItemView"][data-unread="true"] [class*="roomName"],
[class*="RoomListItemView"][data-unread="true"] [class*="name"],
[class*="RoomListItemView"][data-unread="true"] [class*="title"] {
    color: #0a0a0a !important;
    font-weight: 600 !important;
}

/* Last-message preview / secondary text — tiny and quiet */
[class*="RoomListItemView"] [class*="lastMessage"],
[class*="RoomListItemView"] [class*="subtitle"],
[class*="RoomListItemView"] [class*="preview"] {
    font-size: 12px !important;
    color: #71717a !important;
    font-weight: 400 !important;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 3 — Лента сообщений в Linear-стиле                                     */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Chat canvas — pure white (sidebar is #FAFAFA, so contrast reads) ────── */
.mx_RoomView,
.mx_RoomView_body,
.mx_MainSplit,
.mx_ScrollPanel {
    background-color: #ffffff !important;
}

/* ── Message tile — comfortable reading width and rhythm ─────────────────── */
.mx_EventTile {
    padding-top: 4px !important;
    padding-bottom: 4px !important;
}

/* Telegram-style: no fade on hover, no fade when the floating action bar opens.
   Only the explicit "selected" state (right-click / context menu open) lights
   up the row, with a smooth fade. */
.mx_EventTile,
.mx_EventTile .mx_EventTile_line {
    transition: background-color 0.15s ease;
}

.mx_EventTile:hover,
.mx_EventTile:hover .mx_EventTile_line,
.mx_EventTile.mx_EventTile_actionBarFocused,
.mx_EventTile.mx_EventTile_actionBarFocused .mx_EventTile_line {
    background-color: transparent !important;
}

/* Selected (right-click / opened context menu) — soft grey on the whole row.
   Paint the background on the OUTER .mx_EventTile (full row width) and keep
   the inner .mx_EventTile_line transparent so the grey bleeds edge-to-edge. */
.mx_EventTile.mx_EventTile_selected {
    background-color: #f4f4f5 !important;
}

.mx_EventTile.mx_EventTile_selected > .mx_EventTile_line,
.mx_EventTile.mx_EventTile_selected .mx_EventTile_line {
    background-color: transparent !important;
    box-shadow: none !important;
    /* Element adds +20px to padding-inline-start when selected (for its purple
       inset bar). Restore the base padding so the text doesn't shift. */
    padding-inline-start: var(--EventTile_group_line-spacing-inline-start) !important;
}

/* ── Sender name — sharp, near-black, only on first message in a group ──── */
.mx_DisambiguatedProfile_displayName {
    color: #0a0a0a !important;
    font-weight: 600 !important;
    font-size: 14px !important;
    letter-spacing: -0.005em;
}

/* ── Body text — softer than pure black, generous line-height ────────────── */
.mx_EventTile_body,
.mx_EventTile_content,
.mx_MTextBody {
    color: #27272a !important;
    font-size: 15px !important;
    line-height: 1.55 !important;
    letter-spacing: -0.003em;
}

/* ── Timestamp — quiet 12px next to the name, muted grey ─────────────────── */
.mx_MessageTimestamp {
    color: #a1a1aa !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    font-variant-numeric: tabular-nums;
}

/* ── Telegram-style timestamp positioning ────────────────────────────────── */
/* Our injected inline timestamp lives inside .mx_EventTile_line and pins to
   the right edge of the message row. The original group-line timestamp (and
   any hover-timestamp in the avatar gutter) get hidden so we have one. */

.mx_EventTile_line {
    position: relative !important;
    padding-right: 56px !important; /* room for the right-anchored timestamp */
}

.mx_EventTile_inlineTimestamp {
    position: absolute !important;
    right: 12px;
    top: 6px; /* aligns with the first text line baseline */
    pointer-events: auto;
    line-height: 1;
}

.mx_EventTile_inlineTimestamp .mx_MessageTimestamp {
    color: #a1a1aa !important;
    font-size: 11px !important;
    font-variant-numeric: tabular-nums;
}

/* Hide the original group-line timestamp (the one next to the sender name).
   We render our own on the message row instead, Telegram-style. */
.mx_EventTile .mx_EventTile_line > .mx_MessageTimestamp,
.mx_EventTile_senderDetails > .mx_MessageTimestamp {
    display: none !important;
}

/* Hide the hover-only timestamp/avatar that Element draws in the avatar
   gutter for continuation rows — replaced by our inline timestamp. */
.mx_EventTile_continuation .mx_EventTile_avatar,
.mx_EventTile_continuation > .mx_BaseAvatar {
    display: none !important;
}

/* Tighten continuation rows so they read as one paragraph from the same person */
.mx_EventTile_continuation {
    margin-top: 0 !important;
    padding-top: 1px !important;
    padding-bottom: 1px !important;
}

/* ── Day separator («Сегодня», «Вчера») — small, centred, hair-thin rules ── */
.mx_TimelineSeparator {
    color: #71717a !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.mx_TimelineSeparator hr {
    border-color: #e4e4e7 !important;
    border-width: 1px 0 0 0 !important;
}

/* ── Action bar on hover (reactions/reply/edit) — clean white card ───────── */
.mx_MessageActionBar {
    background-color: #ffffff !important;
    border: 1px solid #e4e4e7 !important;
    border-radius: 6px !important;
    box-shadow: 0 1px 2px rgb(0, 0, 0, 0.04) !important;
}

.mx_MessageActionBar_iconButton:hover {
    background-color: #f4f4f5 !important;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 4 — Header чата в Linear-стиле                                         */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Header — substantial, breathable, hair-thin separator ──────────────── */
.mx_RoomHeader {
    height: 64px !important;
    min-height: 64px !important;
    padding: 0 20px !important;
    background-color: #ffffff !important;
    border-bottom: 1px solid #e4e4e7 !important;
    box-shadow: none !important;
    gap: 12px;
}

/* Avatar — keep at solid 36px, no border */
.mx_RoomHeader .mx_BaseAvatar,
.mx_RoomHeader .mx_DecoratedRoomAvatar {
    width: 36px !important;
    height: 36px !important;
}

/* Room title — bold and present, 16/650, tight tracking */
.mx_RoomHeader_nametext,
.mx_RoomHeader_heading,
.mx_RoomHeader h1 {
    font-size: 16px !important;
    font-weight: 650 !important;
    letter-spacing: -0.015em !important;
    color: #0a0a0a !important;
    line-height: 1.2 !important;
}

/* Subtitle (participants count / topic) — quiet 12.5px */
.mx_RoomHeader_topic,
.mx_RoomHeader [class*="subtitle"],
.mx_RoomHeader [class*="info"] {
    font-size: 12.5px !important;
    color: #71717a !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
}

/* Right-side action icons — muted, 20px, hover darkens with a soft pill bg */
.mx_RoomHeader_button,
.mx_RoomHeader [role="button"] svg,
.mx_RoomHeader button svg {
    color: #52525b !important;
    width: 20px !important;
    height: 20px !important;
    transition:
        color 0.12s ease,
        background-color 0.12s ease;
}

.mx_RoomHeader_button:hover,
.mx_RoomHeader [role="button"]:hover svg,
.mx_RoomHeader button:hover svg {
    color: #0a0a0a !important;
}

.mx_RoomHeader_button:hover,
.mx_RoomHeader button[class*="iconButton"]:hover {
    background-color: #f4f4f5 !important;
}

/* Icon button hit area — generous but neat */
.mx_RoomHeader_button,
.mx_RoomHeader button[class*="iconButton"] {
    width: 36px !important;
    height: 36px !important;
    border-radius: 8px !important;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 5 — Композер в Linear-стиле                                            */
/* ══════════════════════════════════════════════════════════════════════════ */

/* Outer composer area — clean white with breathing room around the card */
.mx_MessageComposer {
    background-color: #ffffff !important;
    border-top: 1px solid #e4e4e7 !important;
    padding: 12px 16px 14px !important;
    box-sizing: border-box;
}

/* The actual writing card — substantial, soft off-white, breathing padding */
.mx_MessageComposer_wrapper {
    background-color: #fafafa !important;
    border: 1px solid #e4e4e7 !important;
    border-radius: 12px !important;
    padding: 10px 12px !important;
    min-height: 52px !important;
    box-sizing: border-box;
    box-shadow: 0 1px 2px rgb(0, 0, 0, 0.03);
    transition:
        border-color 0.12s ease,
        background-color 0.12s ease;
}

/* Hover — slightly darker border */
.mx_MessageComposer_wrapper:hover {
    border-color: #d4d4d8 !important;
}

/* Focus — quiet darker grey + lift to pure white inside */
.mx_MessageComposer_wrapper:focus-within {
    border-color: #a1a1aa !important;
    background-color: #ffffff !important;
    box-shadow: none !important;
}

/* Side icons cluster — pack them tightly to the right edge */
.mx_MessageComposer_actions,
.mx_MessageComposer_buttons {
    gap: 4px !important;
    padding-right: 0 !important;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 6 — Микродетали (фокус-кольца, скроллбары, штрихи)                     */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Custom scrollbars — thin, Linear-style ──────────────────────────────── */
/* WebKit / Chromium */
*::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

*::-webkit-scrollbar-track {
    background: transparent;
}

*::-webkit-scrollbar-thumb {
    background-color: transparent;
    border-radius: 6px;
    border: 2px solid transparent;
    background-clip: padding-box;
    transition: background-color 0.15s ease;
}

/* Show the thumb only when the user hovers a scrollable area */
*:hover::-webkit-scrollbar-thumb {
    background-color: #d4d4d8;
    background-clip: padding-box;
}

*::-webkit-scrollbar-thumb:hover {
    background-color: #a1a1aa !important;
}

*::-webkit-scrollbar-corner {
    background: transparent;
}

/* Firefox */
* {
    scrollbar-width: thin;
    scrollbar-color: #d4d4d8 transparent;
}

/* ── Focus rings — Linear-style on interactive elements ──────────────────── */
/* Default: clear browser focus outline, replace with our own ring.
   Only show on keyboard navigation (:focus-visible), not on mouse clicks. */
button,
a,
[role="button"],
[role="link"],
[role="menuitem"],
[role="option"],
[role="tab"],
input,
textarea,
select {
    outline: none !important;
}

button:focus-visible,
a:focus-visible,
[role="button"]:focus-visible,
[role="link"]:focus-visible,
[role="menuitem"]:focus-visible,
[role="option"]:focus-visible,
[role="tab"]:focus-visible {
    outline: none !important;
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #5e6ad2 !important;
    border-radius: 6px;
    transition: box-shadow 0.1s ease;
}

/* Сообщения, комнаты, SpacePanel — без focus-ring (мешает визуально) */
.mx_EventTile:focus,
.mx_EventTile:focus-visible,
.mx_EventTile *:focus,
.mx_EventTile *:focus-visible,
.mx_EventTile :focus-within,
[class*="RoomListItemView"]:focus,
[class*="RoomListItemView"]:focus-visible,
.mx_SpaceButton:focus,
.mx_SpaceButton:focus-visible,
.mx_SpacePanel button:focus,
.mx_SpacePanel button:focus-visible {
    outline: none !important;
    box-shadow: none !important;
}

/* ── Buttons — smooth micro-press on click ───────────────────────────────── */
button:not(:disabled):active,
[role="button"]:not([aria-disabled="true"]):active {
    transform: scale(0.97);
    transition: transform 0.06s ease;
}

button {
    transition:
        background-color 0.12s ease,
        color 0.12s ease,
        border-color 0.12s ease,
        transform 0.06s ease;
}

/* ── Links — accent on hover, no underline pollution ─────────────────────── */
a {
    color: #5e6ad2;
    text-decoration: none;
    transition: color 0.12s ease;
}

a:hover {
    color: #4f5bc2;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
}

/* ── Tooltips — quick, soft ──────────────────────────────────────────────── */
[role="tooltip"],
.mx_Tooltip {
    background-color: #18181b !important;
    color: #fafafa !important;
    border-radius: 6px !important;
    font-size: 12px !important;
    padding: 6px 10px !important;
    box-shadow: 0 4px 12px rgb(0, 0, 0, 0.12) !important;
    border: none !important;
}

/* ── Dividers / borders across the app — unified hairlines ───────────────── */
hr,
.mx_Separator {
    border: none !important;
    border-top: 1px solid #e4e4e7 !important;
    background-color: transparent !important;
    height: 0 !important;
    margin: 12px 0 !important;
}

/* ── Inputs / textareas — Linear's quiet field treatment ─────────────────── */
input[type="text"],
input[type="search"],
input[type="email"],
input[type="password"],
textarea {
    border-radius: 6px;
    transition:
        border-color 0.12s ease,
        background-color 0.12s ease;
}

/* ── Subtle text rendering polish app-wide ───────────────────────────────── */
body {
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
}

/* Tabular figures in places where numbers stack (counters, settings) */
.mx_NotificationBadge,
[class*="badge"],
[class*="Badge"],
[class*="count"],
[class*="Count"] {
    font-variant-numeric: tabular-nums;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 7 — Правая панель в Linear-стиле                                       */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Outer panel — off-white, mirrors the sidebar to feel like a side rail ── */
.mx_RightPanel {
    background-color: #fafafa !important;
    border-left: 1px solid #e4e4e7 !important;
    box-shadow: none !important;
}

/* ── BaseCard (the chrome inside the panel: header + body) ───────────────── */
.mx_BaseCard {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
}

/* Card header — tight, near-black title, hair-thin separator */
.mx_BaseCard_header,
.mx_BaseCard_Header {
    padding: 14px 16px !important;
    border-bottom: 1px solid #e4e4e7 !important;
    background-color: transparent !important;
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.mx_BaseCard_header_title,
.mx_BaseCard_header h2 {
    font-size: 14px !important;
    font-weight: 600 !important;
    color: #0a0a0a !important;
    letter-spacing: -0.005em;
    line-height: 1.2 !important;
}

/* Close (X) / back buttons inside card header — muted icons */
.mx_BaseCard_close,
.mx_BaseCard_back,
.mx_BaseCard_header [role="button"] svg {
    color: #71717a !important;
    transition:
        color 0.12s ease,
        background-color 0.12s ease;
}

.mx_BaseCard_close:hover,
.mx_BaseCard_back:hover {
    color: #0a0a0a !important;
    background-color: #f4f4f5 !important;
    border-radius: 6px;
}

/* ── Card body — comfortable inner padding ────────────────────────────────── */
.mx_BaseCard > div:not(.mx_BaseCard_header),
.mx_BaseCard_Body {
    padding: 8px 0 !important;
}

/* ── Member list rows — dense, with quiet hover ──────────────────────────── */
.mx_MemberList .mx_EntityTile,
.mx_MemberList [class*="MemberTile"],
.mx_MemberList [role="listitem"] {
    padding: 6px 16px !important;
    min-height: 40px !important;
    transition: background-color 0.1s ease;
}

.mx_MemberList .mx_EntityTile:hover,
.mx_MemberList [class*="MemberTile"]:hover,
.mx_MemberList [role="listitem"]:hover {
    background-color: #f4f4f5 !important;
}

/* Member name */
.mx_MemberList .mx_EntityTile_name,
.mx_MemberList [class*="name"] {
    font-size: 13.5px !important;
    font-weight: 500 !important;
    color: #0a0a0a !important;
    letter-spacing: -0.005em;
}

/* Member status / presence */
.mx_MemberList [class*="presence"],
.mx_MemberList [class*="subtitle"] {
    font-size: 11.5px !important;
    color: #71717a !important;
}

/* Section labels (Online / Offline / Joined / Invited) */
.mx_MemberList h3,
.mx_MemberList [class*="sectionHeader"],
.mx_MemberList [class*="categoryHeader"] {
    font-size: 11px !important;
    font-weight: 600 !important;
    color: #71717a !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    padding: 12px 16px 6px !important;
    background-color: transparent !important;
}

/* Member count badge */
.mx_MemberList [class*="memberCount"],
.mx_MemberList .mx_BaseCard_header_title_counter {
    color: #71717a !important;
    font-weight: 400 !important;
    font-size: 12px !important;
}

/* ── Search inside the panel (members search etc.) ──────────────────────── */
.mx_BaseCard input[type="search"],
.mx_BaseCard input[type="text"] {
    background-color: #ffffff !important;
    border: 1px solid #e4e4e7 !important;
    border-radius: 6px !important;
    padding: 6px 10px !important;
    font-size: 13px !important;
    transition: border-color 0.12s ease;
}

.mx_BaseCard input[type="search"]:hover,
.mx_BaseCard input[type="text"]:hover {
    border-color: #d4d4d8 !important;
}

.mx_BaseCard input[type="search"]:focus,
.mx_BaseCard input[type="text"]:focus {
    border-color: #a1a1aa !important;
    box-shadow: none !important;
}

/* ── Pinned / Files / Polls cards inside the panel ───────────────────────── */
.mx_PinnedMessagesCard .mx_EventTile,
.mx_FilePanel .mx_EventTile,
.mx_TimelineCard .mx_EventTile {
    padding: 8px 16px !important;
    border-radius: 6px;
    margin: 2px 8px !important;
    transition: background-color 0.1s ease;
}

.mx_PinnedMessagesCard .mx_EventTile:hover,
.mx_FilePanel .mx_EventTile:hover,
.mx_TimelineCard .mx_EventTile:hover {
    background-color: #f4f4f5 !important;
}

/* ── Empty state inside cards (no pinned, no files etc.) ─────────────────── */
.mx_BaseCard [class*="empty"],
.mx_BaseCard [class*="Empty"] {
    color: #71717a !important;
    font-size: 13px !important;
    text-align: center;
    padding: 32px 16px !important;
}

/* ── Room summary card (the menu inside right panel) ─────────────────────── */
/* Top section: avatar + room name + badges */
.mx_RoomSummaryCard_container {
    padding: 20px 16px 12px !important;
    border-bottom: 1px solid #e4e4e7;
    margin-bottom: 4px;
}

.mx_RoomSummaryCard_roomName {
    font-size: 16px !important;
    font-weight: 650 !important;
    letter-spacing: -0.012em !important;
    color: #0a0a0a !important;
}

.mx_RoomSummaryCard_alias,
.mx_RoomSummaryCard_topic {
    font-size: 12.5px !important;
    color: #71717a !important;
    line-height: 1.4 !important;
}

/* Menu items inside the room summary card.
   Compound's MenuItem renders as a <button> with hashed CSS Module classes.
   Target the buttons directly + the hashed `_item_*` class as backup. */
.mx_RoomSummaryCard button,
.mx_RoomSummaryCard [role="menuitem"],
.mx_RoomSummaryCard [class*="_item_"] {
    padding: 8px 16px !important;
    min-height: 40px !important;
    font-size: 13.5px !important;
    font-weight: 450 !important;
    color: #18181b !important;
    border-radius: 0 !important;
    background-color: transparent !important;
    transition: background-color 0.1s ease;
}

.mx_RoomSummaryCard button:hover,
.mx_RoomSummaryCard [role="menuitem"]:hover,
.mx_RoomSummaryCard [class*="_item_"]:hover {
    background-color: #f4f4f5 !important;
}

/* All icons inside menu items — muted, fixed size */
.mx_RoomSummaryCard button svg,
.mx_RoomSummaryCard [role="menuitem"] svg,
.mx_RoomSummaryCard [class*="_item_"] svg {
    color: #52525b !important;
    width: 18px !important;
    height: 18px !important;
    flex-shrink: 0;
}

/* Destructive items (Leave / Report) — soft red */
.mx_RoomSummaryCard button[data-kind="critical"],
.mx_RoomSummaryCard [class*="_item_"][data-kind="critical"] {
    color: #dc2626 !important;
}

.mx_RoomSummaryCard button[data-kind="critical"] svg,
.mx_RoomSummaryCard [class*="_item_"][data-kind="critical"] svg {
    color: #dc2626 !important;
}

/* ── Badges в правой панели (Зашифровано, Новые участники не видят, и т.д.) ─ */
/* Сейчас они яркие фиолетовые/lavender — делаем тихим серым */
.mx_RoomSummaryCard [class*="_badge_"],
.mx_RoomSummaryCard [class*="Badge"]:not(button) {
    background-color: #f4f4f5 !important;
    color: #52525b !important;
    border: none !important;
    font-size: 12px !important;
    font-weight: 450 !important;
    border-radius: 6px !important;
    padding: 4px 8px !important;
}

.mx_RoomSummaryCard [class*="_badge_"] svg,
.mx_RoomSummaryCard [class*="Badge"]:not(button) svg {
    color: #71717a !important;
    width: 14px !important;
    height: 14px !important;
}

/* «Добавить тему» — тихая ссылка вместо акцентной */
.mx_RoomSummaryCard_topic [class*="add"],
.mx_RoomSummaryCard button[aria-label*="тему"],
.mx_RoomSummaryCard [class*="add_topic"] {
    color: #71717a !important;
    font-weight: 450 !important;
    font-size: 13px !important;
    background: transparent !important;
}

/* Аватар в карточке пользователя — без лишней рамки */
.mx_RoomSummaryCard_container .mx_BaseAvatar {
    box-shadow: none !important;
}

/* Имя в правой панели — крупное, лёгкое weight */
.mx_RoomSummaryCard_container .mx_RoomSummaryCard_roomName,
.mx_RoomSummaryCard_container h2,
.mx_RoomSummaryCard_container h3 {
    font-size: 18px !important;
    font-weight: 600 !important;
    letter-spacing: -0.015em !important;
    color: #0a0a0a !important;
    margin-top: 12px !important;
}

/* Пункты меню (Избранное, Пригласить, Люди, ...) — высота 44px, без подложки */
.mx_RoomSummaryCard button,
.mx_RoomSummaryCard [role="menuitem"] {
    min-height: 44px !important;
    padding: 0 20px !important;
    gap: 14px !important;
    background-color: transparent !important;
    border: none !important;
    color: #18181b !important;
    font-size: 14px !important;
    font-weight: 450 !important;
    letter-spacing: -0.005em !important;
}

.mx_RoomSummaryCard button:hover,
.mx_RoomSummaryCard [role="menuitem"]:hover {
    background-color: #f4f4f5 !important;
}

/* Иконки пунктов — серее, чуть мельче */
.mx_RoomSummaryCard button svg:not([class*="badge"]),
.mx_RoomSummaryCard [role="menuitem"] svg:not([class*="badge"]) {
    color: #71717a !important;
    width: 18px !important;
    height: 18px !important;
}

/* Счётчик у пункта (например "2" у Закреплённых) — тонкий серый */
.mx_RoomSummaryCard button [class*="counter"],
.mx_RoomSummaryCard [role="menuitem"] [class*="counter"],
.mx_RoomSummaryCard button [class*="count"],
.mx_RoomSummaryCard [role="menuitem"] [class*="count"] {
    color: #71717a !important;
    font-size: 12px !important;
    font-weight: 450 !important;
    background: transparent !important;
}

/* Деструктивные пункты внизу (Комната отчётов, Покинуть чат) — мягкий красный */
.mx_RoomSummaryCard button[data-kind="critical"],
.mx_RoomSummaryCard [data-kind="critical"] {
    color: #dc2626 !important;
}

.mx_RoomSummaryCard button[data-kind="critical"] svg,
.mx_RoomSummaryCard [data-kind="critical"] svg {
    color: #dc2626 !important;
}

/* Search в шапке правой панели — выровнять под линейный стиль */
.mx_BaseCard input[type="search"],
.mx_BaseCard input[type="text"] {
    background-color: #ffffff !important;
    border: 1px solid #ededef !important;
    border-radius: 8px !important;
    padding: 8px 12px !important;
    font-size: 13px !important;
}

/* Поправить отступы между секциями меню — добавить «дыхание» */
.mx_RoomSummaryCard hr,
.mx_RoomSummaryCard [class*="separator"] {
    margin: 8px 0 !important;
    border: none !important;
    border-top: 1px solid #ededef !important;
}

/* ── BaseCard header (поиск + X в шапке правой панели) ──────────────────── */
/* Сейчас поиск рендерится как отдельная иконка-кружок + input + X. Делаем
   единый rounded pill, иконку поглощаем внутрь input'а. */
.mx_BaseCard_header {
    padding: 12px 16px !important;
    gap: 8px !important;
    align-items: center !important;
}

/* Скрыть «лишнюю» иконку поиска снаружи input'а (если есть отдельный icon-button) */
.mx_BaseCard_header > [class*="searchIcon"],
.mx_BaseCard_header > button[aria-label*="Поиск"],
.mx_BaseCard_header > [role="button"][aria-label*="Search"] {
    display: none !important;
}

/* Search component (Compound) — единый pill во всю ширину.
   ВАЖНО: стилизуем ТОЛЬКО внутренний Compound `._search_` элемент, иначе
   получаем два вложенных pill'а (форма + Compound). Форму делаем прозрачной. */
.mx_BaseCard_header form,
.mx_BaseCard_header [role="search"],
.mx_BaseCard_header .mx_RoomSummaryCard_search {
    flex: 1 !important;
    background-color: transparent !important;
    border: none !important;
    padding: 0 !important;
    display: block !important;
    min-height: 0 !important;
}

/* Compound's _search_ — это сам pill */
.mx_BaseCard_header [class*="_search_"] {
    background-color: #f4f4f5 !important;
    border: none !important;
    border-radius: 999px !important;
    padding: 0 14px !important;
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    min-height: 36px !important;
    box-shadow: none !important;
    outline: none !important;
}

/* Compound's search icon inside the pill */
.mx_BaseCard_header [class*="_search_"] [class*="_icon_"],
.mx_BaseCard_header [class*="_search_"] svg:first-child {
    color: #71717a !important;
    width: 16px !important;
    height: 16px !important;
    flex-shrink: 0;
}

/* Compound's input inside the pill — никакого фона/рамки, только текст */
.mx_BaseCard_header [class*="_search_"] [class*="_input_"],
.mx_BaseCard_header [class*="_search_"] input {
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    font-size: 13px !important;
    color: #18181b !important;
    width: 100% !important;
    min-width: 0;
}

.mx_BaseCard_header [class*="_search_"]:focus-within {
    background-color: #ededef !important;
}

/* Compound's clear-button (X) внутри Search — спокойный серый, маленький,
   не «вылезает» за пилюлю. */
.mx_BaseCard_header [class*="_search_"] button,
.mx_BaseCard_header [class*="_search_"] [role="button"],
.mx_BaseCard_header [class*="_search_"] [class*="cancel"],
.mx_BaseCard_header [class*="_search_"] [class*="clear"] {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    width: 20px !important;
    height: 20px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    color: #71717a !important;
    flex-shrink: 0;
}

.mx_BaseCard_header [class*="_search_"] button svg,
.mx_BaseCard_header [class*="_search_"] [role="button"] svg {
    width: 14px !important;
    height: 14px !important;
    color: #71717a !important;
}

.mx_BaseCard_header [class*="_search_"] button:hover {
    background-color: rgb(0, 0, 0, 0.06) !important;
    color: #18181b !important;
}

/* ── Иконки пунктов меню — ровная колонка слева ──────────────────────────── */
/* Жёсткий каркас flex: первый ребёнок = коробка 24px, потом gap 16px, потом
   текст. Это гарантирует что текст всех пунктов начинается с одной x-линии. */
.mx_RoomSummaryCard button,
.mx_RoomSummaryCard [role="menuitem"] {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    padding: 0 20px !important;
}

/* Первый ребёнок (иконка/контейнер иконки) — фиксированная коробка 24px */
.mx_RoomSummaryCard button > *:first-child,
.mx_RoomSummaryCard [role="menuitem"] > *:first-child {
    width: 24px !important;
    height: 24px !important;
    flex-shrink: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
}

/* Сам SVG внутри коробки — 18×18 центром */
.mx_RoomSummaryCard button > *:first-child svg,
.mx_RoomSummaryCard [role="menuitem"] > *:first-child svg,
.mx_RoomSummaryCard button > svg:first-child,
.mx_RoomSummaryCard [role="menuitem"] > svg:first-child {
    width: 18px !important;
    height: 18px !important;
    color: #71717a !important;
    display: block !important;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 9 — SpacePanel: только базовая палитра, без структурных правок         */
/* ══════════════════════════════════════════════════════════════════════════ */

/* Фон белый (как сайдбар), всё остальное оставляем как у Element-дефолта */
.mx_SpacePanel {
    background-color: #fbfbfb !important;
}

/* Notification badge на иконках SpacePanel — чистая пилюля справа-сверху */
.mx_SpacePanel .mx_SpacePanel_badgeContainer {
    position: absolute !important;
    right: -4px !important;
    top: -4px !important;
    left: auto !important;
    z-index: 2;
}

.mx_SpacePanel .mx_NotificationBadge {
    background-color: #5e6ad2 !important;
    color: #ffffff !important;
    font-size: 10px !important;
    font-weight: 600 !important;
    min-width: 16px !important;
    height: 16px !important;
    padding: 0 4px !important;
    border-radius: 8px !important;
    border: 2px solid #fbfbfb !important;
    box-sizing: content-box !important;
    line-height: 1 !important;
    box-shadow: none !important;
}

/* Dot-режим (без числа, просто точка) — тоже стилизуем */
.mx_SpacePanel .mx_NotificationBadge_dot {
    min-width: 8px !important;
    width: 8px !important;
    height: 8px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    border: 2px solid #fbfbfb !important;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 10 — Telegram-стиль read-receipts                                      */
/* -                                                                          */
/* Логика:                                                                    */
/*   - Своё сообщение, отправлено, ещё не прочитано → ✓ (одна, серая)        */
/*   - Своё сообщение, прочитано получателем        → ✓✓ (две, синие TG)    */
/*   - Входящее сообщение                            → ничего (галочек нет)  */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── 1. Галочки скрыты на:                                                  ── */
/*   - ВХОДЯЩИХ сообщениях (мы и так знаем что прочитали их)                 */
/*   - SYSTEM-событиях (пины, изменения настроек, join/leave) — как в TG    */
.mx_EventTile[data-self="false"] .mx_ReadReceiptGroup,
.mx_EventTile[data-self="false"] .mx_SentReceipt,
.mx_EventTile[data-self="false"] [class*="SentReceipt"],
.mx_EventTile_info .mx_ReadReceiptGroup,
.mx_EventTile_info .mx_SentReceipt,
.mx_EventTile_info [class*="SentReceipt"] {
    display: none !important;
}

/* Также не рисуем ::after на system-событиях */
.mx_EventTile_info .mx_ReadReceiptGroup::after {
    display: none !important;
}

/* ── Presence subtitle в шапке DM-чата («в сети» / «был в HH:MM») ────────── */
.mx_RoomHeader_presenceSubtitle {
    font-size: 12px !important;
    color: #71717a !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
    margin-top: 2px;
}

.mx_RoomHeader_presenceSubtitle[data-presence="online"] {
    color: #22c55e !important;
}

.mx_RoomHeader_presenceSubtitle[data-presence="typing"] {
    color: #5e6ad2 !important;
    font-style: italic;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Плавность переключения чатов — TG-like crossfade                           */
/* ══════════════════════════════════════════════════════════════════════════ */
@keyframes mx_LinearChatFadeIn {
    from {
        opacity: 0;
        transform: translateY(4px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Анимируется при каждом ремаунте RoomView (новый chat → новый key) */
.mx_RoomView,
.mx_RoomView_body,
.mx_ScrollPanel {
    animation: mx_LinearChatFadeIn 220ms ease-out;
}

/* Header чата тоже плавно появляется */
.mx_RoomHeader {
    animation: mx_LinearChatFadeIn 180ms ease-out;
}

/* ── Highlight новых сообщений: мягкая вспышка на последнем event-tile ──── */
/* Анимация запускается при mount. Когда приходит новое сообщение, оно
   становится новым последним и анимируется. При открытии чата последнее
   сообщение тоже подсвечивается — это работает как «вот где ты остановился». */
@keyframes mx_LinearMessageFlash {
    0% {
        background-color: rgb(94, 106, 210, 0);
    }
    25% {
        background-color: rgb(94, 106, 210, 0.08);
    }
    100% {
        background-color: rgb(94, 106, 210, 0);
    }
}

.mx_EventTile_last {
    animation: mx_LinearMessageFlash 1.6s ease-out;
}

/* ── Отключаем тултип «Просмотрел N человек» на hover галочек ────────────── */
/* Информация о прочтении уйдёт в context-меню — как в Telegram */
.mx_ReadReceiptGroup,
.mx_SentReceipt,
[class*="SentReceipt"] {
    pointer-events: none !important;
}

/* ── 2. Скрываем дефолтные аватарки прочитавших, оставляем только контейнер ── */
.mx_ReadReceiptGroup .mx_BaseAvatar,
.mx_ReadReceiptGroup_container > * {
    display: none !important;
}

.mx_ReadReceiptGroup {
    width: auto !important;
    height: auto !important;
    min-width: 16px;
    min-height: 14px;
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center;
    position: relative;
}

/* ── 3. ПРОЧИТАНО (своё сообщение) → ✓✓ синяя Telegram (#4FA3E3) ─────────── */
/* Двойную галочку рисуем ТОЛЬКО когда внутри ReadReceiptGroup реально есть
   аватарка прочитавшего (значит получатель открыл чат). Если контейнер
   пустой — Element покажет SentReceipt отдельно (наша серая ✓). */
.mx_EventTile[data-self="true"] .mx_ReadReceiptGroup:has(.mx_BaseAvatar)::after {
    content: "";
    display: inline-block;
    width: 16px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 12' fill='none' stroke='%234FA3E3' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><polyline points='1 6 4 9 9 3'/><polyline points='7 6 10 9 15 3'/></svg>");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

/* Пустой ReadReceiptGroup (никто не прочитал) — показываем серую одиночную ✓
   точно так же как SentReceipt, чтобы не было «дырки» в UI */
.mx_EventTile[data-self="true"] .mx_ReadReceiptGroup:not(:has(.mx_BaseAvatar))::after {
    content: "";
    display: inline-block;
    width: 16px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 12' fill='none' stroke='%23a1a1aa' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><polyline points='2 6 6 10 14 2'/></svg>");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

/* ── 4. ОТПРАВЛЕНО (своё сообщение, ещё не прочитано) → ✓ серая ──────────── */
.mx_EventTile[data-self="true"] .mx_SentReceipt,
.mx_EventTile[data-self="true"] [class*="SentReceipt"] {
    width: 16px !important;
    height: 12px !important;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 12' fill='none' stroke='%23a1a1aa' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><polyline points='2 6 6 10 14 2'/></svg>") !important;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    background-color: transparent !important;
    border: none !important;
}

.mx_SentReceipt svg,
.mx_SentReceipt img,
[class*="SentReceipt"] svg,
[class*="SentReceipt"] img {
    display: none !important;
}

/* ── 5. ПРОПАГАЦИЯ «прочитано» на ВСЕ предыдущие own-сообщения ──────────── */
/* Matrix shows the read-avatar только на последнем прочитанном событии —
   и это может быть ЛЮБОЕ событие (текст, system-event, pin, reaction).
   Смотрим на любого следующего сиблинга с read-avatar — если он есть,
   значит все предыдущие own-сообщения прочитаны. */

/* SentReceipt предыдущего сообщения → синяя ✓✓ (Telegram blue) */
.mx_EventTile[data-self="true"]:has(
    ~ .mx_EventTile .mx_ReadReceiptGroup .mx_BaseAvatar
) [class*="SentReceipt"],
.mx_EventTile[data-self="true"]:has(
    ~ .mx_EventTile .mx_ReadReceiptGroup .mx_BaseAvatar
) .mx_SentReceipt {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 12' fill='none' stroke='%234FA3E3' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><polyline points='1 6 4 9 9 3'/><polyline points='7 6 10 9 15 3'/></svg>") !important;
}

/* Пустой ReadReceiptGroup предыдущего сообщения → тоже синяя ✓✓ */
.mx_EventTile[data-self="true"]:has(
    ~ .mx_EventTile .mx_ReadReceiptGroup .mx_BaseAvatar
)
    .mx_ReadReceiptGroup:not(:has(.mx_BaseAvatar))::after {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 12' fill='none' stroke='%234FA3E3' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><polyline points='1 6 4 9 9 3'/><polyline points='7 6 10 9 15 3'/></svg>") !important;
}


/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 8 — Полировочный проход: ЛЁГКОСТЬ и ПЛАВНОСТЬ                          */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Универсальные транзишены для воздушности ─────────────────────────────── */
/* Каждый интерактивный элемент должен плавно реагировать. Очень быстрые
   тайминги (80-150ms) — еле заметно глазу, но сильно поднимает «дорогость». */
button,
a,
[role="button"],
[role="menuitem"],
[role="tab"],
.mx_RoomListItemView,
.mx_RoomListItemView *,
.mx_BaseAvatar,
.mx_RoomTile,
.mx_RoomSearch,
.mx_MessageComposer_wrapper {
    transition:
        background-color 0.12s ease,
        color 0.12s ease,
        border-color 0.12s ease,
        opacity 0.12s ease,
        transform 0.12s ease !important;
}

/* ── Облегчение всех границ — заменяем #e4e4e7 на ещё светлее #ededef ───── */
.mx_RoomListPanel,
.mx_LeftPanel,
.mx_RightPanel,
.mx_RoomHeader,
.mx_MessageComposer,
.mx_BaseCard_header,
.mx_RoomSummaryCard_container {
    border-color: #ededef !important;
}

/* Совсем убираем тени в композере — пусть будет просто чистая рамка */
.mx_MessageComposer_wrapper {
    box-shadow: none !important;
    border-color: #ededef !important;
}

/* ── Снижаем визуальный вес SpacePanel-бейджей ────────────────────────────── */
/* Notification-бейджи делаем тоньше, мельче, спокойнее */
.mx_SpacePanel .mx_NotificationBadge,
.mx_SpacePanel [class*="NotificationBadge"],
.mx_SpaceButton .mx_NotificationBadge {
    background-color: #5e6ad2 !important;
    color: #ffffff !important;
    font-size: 10px !important;
    font-weight: 500 !important;
    min-width: 16px !important;
    height: 16px !important;
    padding: 0 4px !important;
    border-radius: 8px !important;
    box-shadow: none !important;
}

/* SpacePanel — БЕЛЫЙ как в референсе, тёмные иконки на нём */
.mx_SpacePanel {
    background-color: #ffffff !important;
    border-right: none !important;
}

.mx_SpacePanel,
.mx_SpacePanel *,
.mx_SpacePanel svg {
    color: #18181b !important;
    fill: currentColor;
}

.mx_SpacePanel .mx_SpacePanel_toggleCollapse {
    color: #71717a !important;
}

.mx_SpaceButton:hover,
.mx_SpaceButton_selected {
    background-color: #f4f4f5 !important;
    border-radius: 8px;
}

/* UserMenu (К-аватар вверху) — тоже белый, без рамки */
.mx_UserMenu {
    background-color: #ffffff !important;
    border-top: none !important;
    color: #18181b !important;
}

.mx_UserMenu *,
.mx_UserMenu svg {
    color: #18181b !important;
    fill: currentColor !important;
}

/* ── Сайдбар-заголовки тоньше ─────────────────────────────────────────────── */
/* «Мои чаты» — меньше и легче (650→550) */
.mx_RoomListHeaderView h1,
.mx_LeftPanel h1,
[class*="RoomListHeaderView"] h1 {
    font-size: 14px !important;
    font-weight: 550 !important;
    letter-spacing: -0.008em !important;
    color: #18181b !important;
}

/* ── Облегчаем шрифты комнат в списке (450→400, 13.5→13) ─────────────────── */
[class*="RoomListItemView"] [class*="roomName"],
[class*="RoomListItemView"] [class*="name"],
[class*="RoomListItemView"] [class*="title"] {
    font-size: 13px !important;
    font-weight: 450 !important;
    color: #27272a !important;
}

/* ── Header чата чуть тоньше ──────────────────────────────────────────────── */
/* Имя комнаты — 15/600 вместо 16/650 */
.mx_RoomHeader_nametext,
.mx_RoomHeader_heading,
.mx_RoomHeader h1 {
    font-size: 15px !important;
    font-weight: 600 !important;
    letter-spacing: -0.012em !important;
}

/* Высота header — оставляем 64px (это «дорогое», не «тяжёлое»),
   но padding делаем щедрее */
.mx_RoomHeader {
    padding: 0 24px !important;
}

/* ── Иконки в header-чата ещё тише ────────────────────────────────────────── */
.mx_RoomHeader_button,
.mx_RoomHeader [role="button"] svg,
.mx_RoomHeader button svg {
    color: #71717a !important;
    width: 18px !important;
    height: 18px !important;
}

/* ── Облегчение поля поиска — невидимая рамка пока не в фокусе ───────────── */
.mx_RoomSearch {
    background-color: #ffffff !important;
    border: 1px solid #ededef !important;
    box-shadow: none !important;
}

/* ── Уменьшаем визуальный шум action-bar при hover ────────────────────────── */
.mx_MessageActionBar {
    background-color: #ffffff !important;
    border: 1px solid #ededef !important;
    border-radius: 8px !important;
    box-shadow: 0 2px 8px rgb(0, 0, 0, 0.04) !important;
}

/* ── Pinned-баннер сообщения — тише, без жирного фона ─────────────────────── */
.mx_PinnedMessageBanner {
    background-color: #fafafa !important;
    border-bottom: 1px solid #ededef !important;
    box-shadow: none !important;
}

.mx_PinnedMessageBanner [class*="title"],
.mx_PinnedMessageBanner_title {
    font-weight: 550 !important;
    color: #27272a !important;
}

/* ── Day-separator: TG-стиль sticky pill ─────────────────────────────────── */
/* Sticky применяем к <li>-обёртке, иначе sticky не работает (separator
   заперт внутри своего <li>-родителя, не может «прилипнуть» к scroll-container). */
.mx_RoomView li:has(> .mx_TimelineSeparator) {
    position: sticky !important;
    top: 8px !important;
    z-index: 2;
    pointer-events: none;
    background: transparent !important;
    list-style: none;
}

.mx_TimelineSeparator {
    display: flex !important;
    justify-content: center;
    pointer-events: none;
    margin: 8px 0 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
}

/* Убираем синюю focus-обводку на scroll-контейнере таймлайна —
   она появляется когда панель получает focus (Tab, скриншот) и портит вид. */
.mx_ScrollPanel,
.mx_ScrollPanel:focus,
.mx_ScrollPanel:focus-visible,
.mx_RoomView_messageListWrapper,
.mx_RoomView_messageListWrapper:focus,
.mx_RoomView_messageListWrapper:focus-visible {
    outline: none !important;
    box-shadow: none !important;
}

/* Label-pill — белая с тонкой тенью, по центру */
.mx_TimelineSeparator [class*="label"],
.mx_TimelineSeparator > span,
.mx_TimelineSeparator > div {
    background-color: rgb(255, 255, 255, 0.92) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #71717a !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    padding: 5px 12px !important;
    border-radius: 999px !important;
    box-shadow: 0 1px 3px rgb(0, 0, 0, 0.06), 0 0 0 1px #ededef;
    pointer-events: auto;
}

/* Скрываем дефолтные hr-линии — у нас pill самодостаточный */
.mx_TimelineSeparator hr {
    display: none !important;
}

/* ── Bubble «Шифрование включено» / системные карточки — лёгкие ───────────── */
[class*="EncryptionEvent"],
[class*="encryption"],
.mx_EventTile_info {
    background-color: transparent !important;
}

/* ── Аватары без рамок ───────────────────────────────────────────────────── */
.mx_BaseAvatar,
[class*="Avatar"] {
    box-shadow: none !important;
}

/* ── Скроллбары ещё тоньше ───────────────────────────────────────────────── */
*::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

*:hover::-webkit-scrollbar-thumb {
    background-color: #e4e4e7;
}

/* ── Все кнопки — мягче радиус ───────────────────────────────────────────── */
button,
[role="button"] {
    border-radius: 6px;
}

/* ── Финальный штрих: smooth-scroll внутри панелей (НЕ timeline!) ─────────── */
.mx_BaseCard,
.mx_RightPanel,
.mx_RoomSummaryCard {
    scroll-behavior: smooth;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* Шаг 8b — Видимые сдвиги: убираем тяжесть структурно                        */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ── Полностью УБИРАЕМ границы между панелями — оставляем только цвет ────── */
/* Сейчас сайдбар отделён 1px-границей от чата. Уберём её — пусть отделяет
   только разница в фоне (#fafafa сайдбар vs #ffffff чат). Это самое сильное
   ощущение «лёгкости» — нет линий, есть плоскости. */
.mx_RoomListPanel,
.mx_LeftPanel {
    border-right: none !important;
}

.mx_RightPanel {
    border-left: none !important;
}

/* Header чата БЕЗ нижней границы — отделяется только белым фоном */
.mx_RoomHeader {
    border-bottom: none !important;
}

/* Композер БЕЗ верхней границы */
.mx_MessageComposer {
    border-top: none !important;
}

/* ── Уменьшаем визуальный вес sidebar background tint ─────────────────────── */
/* Делаем сайдбар БЕЛЕЕ, отличие от чата только в волоске — это premium-feel */
.mx_LeftPanel_newRoomList,
.mx_RoomListPanel,
.mx_LeftPanel_roomListWrapper {
    background-color: #fbfbfb !important;
}

.mx_RightPanel {
    background-color: #fbfbfb !important;
}

/* ── Day-separator БЕЗ горизонтальных линий — просто текст ────────────────── */
.mx_TimelineSeparator hr {
    display: none !important;
}

.mx_TimelineSeparator {
    text-align: center;
    padding: 20px 0 !important;
}

.mx_TimelineSeparator [class*="label"],
.mx_TimelineSeparator span {
    background-color: transparent !important;
    color: #a1a1aa !important;
    font-size: 12px !important;
    font-weight: 450 !important;
}

/* ── Воздух между сообщениями разных авторов ─────────────────────────────── */
/* Первое сообщение в группе получает большой отступ сверху от предыдущей
   группы. Создаёт читаемые «абзацы» в ленте. */
.mx_EventTile:not(.mx_EventTile_continuation) {
    margin-top: 16px !important;
}

.mx_EventTile.mx_EventTile_continuation {
    margin-top: 0 !important;
}

/* ── Имена авторов чуть тоньше: 600 → 550 ─────────────────────────────────── */
.mx_DisambiguatedProfile_displayName {
    font-weight: 550 !important;
    color: #18181b !important;
}

/* ── Тело сообщения чуть больше для читаемости ────────────────────────────── */
.mx_EventTile_body,
.mx_MTextBody {
    font-size: 14.5px !important;
    line-height: 1.6 !important;
    color: #18181b !important;
}

/* ── Pinned-баннер становится «листочком», не блоком ──────────────────────── */
.mx_PinnedMessageBanner {
    background-color: transparent !important;
    border-bottom: none !important;
    padding: 8px 24px !important;
    font-size: 13px !important;
}

.mx_PinnedMessageBanner_title {
    font-size: 13px !important;
    color: #71717a !important;
    font-weight: 450 !important;
}

/* ── Композер — карточка ещё мягче, поднимаем её отдельной плоскостью ────── */
.mx_MessageComposer_wrapper {
    border: 1px solid #ededef !important;
    box-shadow: 0 1px 3px rgb(0, 0, 0, 0.02) !important;
    border-radius: 14px !important;
    padding: 12px 14px !important;
}

/* ── Фильтр-чипы тоньше: weight 500 → 450 ────────────────────────────────── */
[data-testid="primary-filters"] button {
    font-weight: 450 !important;
    letter-spacing: -0.005em !important;
}

/* ── Search в сайдбаре — невидимая рамка, ещё легче ──────────────────────── */
.mx_RoomSearch {
    border-color: #ededef !important;
    background-color: #ffffff !important;
}

/* ── Точечные правки под референс ──────────────────────────────────────── */

/* Кнопка коллапса SpacePanel — оставляем как есть, не прячем */

/* 2. Спрятать chevron-кнопку «развернуть фильтры» (стрелка ▼ после чипов) */
[data-testid="primary-filters"] + button,
[data-testid="primary-filters"] ~ button[aria-expanded],
[data-testid="primary-filters"] [class*="expand"],
[data-testid="primary-filters"] [class*="Expand"],
.mx_RoomListPanel button[aria-label*="фильтр"][aria-expanded] {
    display: none !important;
}

/* 3. На нижних landmark-кнопках («Обсуждения», «Настройки») оставить только
   иконки, скрыть текстовые лейблы — как в референсе */
.mx_LegacyRoomHeader_legacyPicker,
.mx_UserMenu_userOptions,
.mx_LeftPanel_userMenu [class*="label"],
.mx_LeftPanel button[aria-label*="Обсуждения"] span:not([class*="icon"]),
.mx_LeftPanel button[aria-label*="Настройки"] span:not([class*="icon"]),
.mx_LeftPanel a[aria-label*="Обсуждения"] span:not([class*="icon"]),
.mx_LeftPanel a[aria-label*="Настройки"] span:not([class*="icon"]) {
    display: none !important;
}

/* 4. Selected-комната — БЕЗ серого фона, только небольшое визуальное
   указание через жирность имени (как в референсе) */
[class*="RoomListItemView"][aria-selected="true"],
[class*="RoomListItemView"][data-selected="true"],
[class*="RoomListItemView"].mx_RoomListItemView_selected {
    background-color: transparent !important;
}

/* Жирнее имя у выбранной комнаты — это и есть «выделение» */
[class*="RoomListItemView"][aria-selected="true"] [class*="roomName"],
[class*="RoomListItemView"][aria-selected="true"] [class*="name"],
[class*="RoomListItemView"][aria-selected="true"] [class*="title"],
[class*="RoomListItemView"][data-selected="true"] [class*="roomName"],
[class*="RoomListItemView"][data-selected="true"] [class*="name"],
[class*="RoomListItemView"][data-selected="true"] [class*="title"] {
    font-weight: 600 !important;
    color: #0a0a0a !important;
}

/* 5. Бейдж непрочитанных у комнаты — в виде точки справа, а не цифры */
[class*="RoomListItemView"] [class*="unreadCounter"],
[class*="RoomListItemView"] [class*="NotificationBadge"] {
    font-size: 10px !important;
    min-width: 14px !important;
    height: 14px !important;
    padding: 0 4px !important;
    border-radius: 7px !important;
    background-color: #71717a !important;
    color: #ffffff !important;
}

/* Inner editor — strip any extra border/bg */
.mx_BasicMessageComposer,
.mx_BasicMessageComposer_input {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

/* Placeholder — quiet grey */
.mx_BasicMessageComposer_input[data-placeholder]::before {
    color: #a1a1aa !important;
    font-weight: 400 !important;
}

/* Send button — solid accent purple, smooth hover */
.mx_MessageComposer_sendMessage,
.mx_MessageComposer button[aria-label*="Отправить"],
.mx_MessageComposer button[aria-label*="Send"] {
    background-color: #5e6ad2 !important;
    color: #ffffff !important;
    border-radius: 8px !important;
    transition: background-color 0.12s ease;
}

.mx_MessageComposer_sendMessage:hover,
.mx_MessageComposer button[aria-label*="Отправить"]:hover,
.mx_MessageComposer button[aria-label*="Send"]:hover {
    background-color: #4f5bc2 !important;
}

/* Side icons (emoji, attach, more) — muted, hover darkens */
.mx_MessageComposer_button svg,
.mx_MessageComposer [role="button"] svg {
    color: #71717a !important;
    transition: color 0.12s ease;
}

.mx_MessageComposer_button:hover svg,
.mx_MessageComposer [role="button"]:hover svg {
    color: #0a0a0a !important;
}

/* ══════════════════════════════════════════════════════════════════════════ */
/* SpacePanel — Linear-style фиксы                                            */
/* -                                                                          */
/* Структура DOM (из shared-components UserMenu + SpacePanel.tsx):             */
/*   nav.mx_SpacePanel[.collapsed]                                            */
/*     div.mx_UserMenu (= UserMenu-module_wrapper, flex-row)                  */
/*       button (triggerButton)                                                */
/*         span > Avatar (compound type="round", 36px) ← розовый круг        */
/*       span (displayName, виден только если expanded=true)                  */
/*     button.mx_SpacePanel_toggleCollapse (position:absolute, right:-8px)    */
/*     ul (список спейсов: home + spaces + "+")                               */
/* ══════════════════════════════════════════════════════════════════════════ */

/* ─── 1. UserMenu: layout + аватарка O ───────────────────────────────────── */

/* Wrapper: flex-row с зазором между аватаркой и именем.
   gap небольшой, padding минимальный — toggle (absolute, right:-8px) рядом. */
.mx_UserMenu {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 12px 16px !important;
    min-width: 0 !important;
}

/* Аватарка O — квадратно-скруглённая 36px (compound Avatar делает круг). */
.mx_UserMenu button > span,
.mx_UserMenu button > span > * {
    border-radius: 8px !important;
}
.mx_UserMenu button img,
.mx_UserMenu button [class*="avatar"] {
    border-radius: 8px !important;
}

/* Имя пользователя — sibling <span> внутри wrapper, обрезаем по ellipsis. */
.mx_UserMenu > span {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    max-width: 100% !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    /* Резерв справа под кнопку-шеврон (она absolute right:-8px) */
    padding-right: 18px !important;
}

/* ─── 2. Toggle ‹ — убираем фокус-ring, делаем мягкий ховер ──────────────── */
.mx_SpacePanel_toggleCollapse,
.mx_SpacePanel_toggleCollapse:focus,
.mx_SpacePanel_toggleCollapse:focus-visible {
    outline: none !important;
    box-shadow: none !important;
}
.mx_SpacePanel_toggleCollapse {
    background-color: #e4e4e7 !important;
    color: #52525b !important;
}

/* ─── 3. Свёрнутый режим (.collapsed, ширина 68px) ───────────────────────── */
/* Все плитки 44×44, square-rounded, одинаковые отступы.                    */

/* UserMenu в свёрнутом виде — центрируем аватарку, имя не показывается */
.mx_SpacePanel.collapsed .mx_UserMenu {
    justify-content: center !important;
    padding: 12px 0 !important;
    gap: 0 !important;
}

/* Все контейнеры в свёрнутом виде — центрируем по горизонтали.
   Дефолт даёт асимметричный padding 4px 4px 4px 0 на SpaceButton,
   плюс ul/AutoHideScrollbar добавляют свои отступы — сбиваем всё. */
.mx_SpacePanel.collapsed,
.mx_SpacePanel.collapsed ul,
.mx_SpacePanel.collapsed .mx_AutoHideScrollbar,
.mx_SpacePanel.collapsed .mx_SpaceTreeLevel {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    align-items: center !important;
}

.mx_SpacePanel.collapsed .mx_SpaceItem {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 3px 0 !important;
    margin: 0 !important;
    width: 100% !important;
}

/* Сам SpaceButton — сбрасываем дефолтный padding 4px 4px 4px 0 */
.mx_SpacePanel.collapsed .mx_SpaceButton {
    padding: 0 !important;
    margin: 0 auto !important;
}

.mx_SpaceButton_narrow {
    width: 44px !important;
    height: 44px !important;
    min-width: 44px !important;
    border-radius: 10px !important;
    padding: 0 !important;
    margin: 0 auto !important;
}

.mx_SpaceButton_narrow .mx_SpaceButton_selectionWrapper {
    width: 44px !important;
    height: 44px !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 10px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
}

.mx_SpaceButton_narrow .mx_SpaceButton_avatarWrapper,
.mx_SpaceButton_narrow .mx_SpaceButton_avatarPlaceholder {
    width: 40px !important;
    height: 40px !important;
    border-radius: 10px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
}

.mx_SpaceButton_narrow .mx_BaseAvatar,
.mx_SpaceButton_narrow .mx_BaseAvatar img,
.mx_SpaceButton_narrow [class*="Avatar"] img,
.mx_SpaceButton_narrow .mx_BaseAvatar_initial {
    width: 40px !important;
    height: 40px !important;
    line-height: 40px !important;
    font-size: 18px !important;
    border-radius: 10px !important;
}

/* Home-иконка крупнее, чтобы визуально сравняться с цифровыми плитками */
.mx_SpaceButton_narrow .mx_SpaceButton_icon svg {
    width: 22px !important;
    height: 22px !important;
}

/* Активный home/spaces в свёрнутом — убираем 3px чёрный border, ставим
   мягкую серую подложку. Дефолт: .mx_SpaceButton_active.mx_SpaceButton_narrow
   .mx_SpaceButton_selectionWrapper { border: 3px solid black }. */
.mx_SpaceButton_narrow.mx_SpaceButton_active .mx_SpaceButton_selectionWrapper,
.mx_SpacePanel.collapsed .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    background-color: #f4f4f5 !important;
    border-radius: 10px !important;
}

.mx_SpaceButton_narrow.mx_SpaceButton_active .mx_SpaceButton_avatarPlaceholder {
    background-color: transparent !important;
    border-radius: 10px !important;
}

/* «+» (создать пространство) в свёрнутом виде — тоже 44×44 */
.mx_SpacePanel.collapsed .mx_SpaceButton_new {
    width: 44px !important;
    height: 44px !important;
    border-radius: 10px !important;
    margin: 4px auto !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
}
.mx_SpacePanel.collapsed .mx_SpaceButton_new svg {
    width: 22px !important;
    height: 22px !important;
}

/* Бейдж уведомлений (home meta-space): top-right относительно аватара */
.mx_SpacePanel .mx_SpacePanel_badgeContainer {
    position: absolute !important;
    top: -4px !important;
    right: -6px !important;
    left: auto !important;
    z-index: 2;
}

/* ─── 4. Развёрнутый режим: pill активного спейса, padding ───────────────── */

/* Внутренний padding панели — даёт inset для активного pill, чтобы он
   не тянулся до краёв (как в референсе). */
.mx_SpacePanel:not(.collapsed) {
    width: 280px !important;
    padding: 0 12px !important;
    box-sizing: border-box !important;
}

.mx_SpacePanel:not(.collapsed) .mx_SpaceItem:not(.mx_SpaceItem_narrow) {
    padding: 2px 0 !important;
}

.mx_SpacePanel:not(.collapsed) .mx_SpaceButton:not(.mx_SpaceButton_narrow) {
    padding: 0 !important;
}

.mx_SpacePanel:not(.collapsed) .mx_SpaceButton:not(.mx_SpaceButton_narrow) .mx_SpaceButton_selectionWrapper {
    border-radius: 10px !important;
    padding: 8px 12px !important;
    width: 100% !important;
    box-sizing: border-box !important;
}

/* Имя спейса/комнаты — больше места, не обрезается раньше времени */
.mx_SpacePanel:not(.collapsed) .mx_SpaceButton_name {
    max-width: none !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    padding-left: 12px !important;
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper {
    background-color: #f4f4f5 !important;
    box-shadow: none !important;
}

/* Убираем дефолтную вертикальную полоску ::before у активного спейса */
.mx_SpacePanel .mx_SpaceButton_active::before,
.mx_SpacePanel .mx_SpaceItem_active::before {
    display: none !important;
}

/* ─── 5. Новый header «ПРОСТРАНСТВА» + inline «+» ────────────────────────── */
.mx_SpacePanel_sectionHeader {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 18px 16px 8px 16px !important;
    margin: 0 !important;
    list-style: none !important;
}

.mx_SpacePanel_sectionHeader_label {
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
    color: #a1a1aa !important;
    text-transform: uppercase !important;
}

.mx_SpacePanel_sectionHeader_add {
    width: 20px !important;
    height: 20px !important;
    border: none !important;
    background: transparent !important;
    color: #71717a !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 4px !important;
    padding: 0 !important;
}
.mx_SpacePanel_sectionHeader_add:hover {
    background-color: #f4f4f5 !important;
    color: #18181b !important;
}
.mx_SpacePanel_sectionHeader_add svg {
    width: 14px !important;
    height: 14px !important;
}

/* В свёрнутом виде header не показывается (рендер с !isPanelCollapsed),
   но на всякий случай скрываем визуально тоже */
.mx_SpacePanel.collapsed .mx_SpacePanel_sectionHeader {
    display: none !important;
}

/* ─── 6. Разделитель перед «+ Создать пространство» ──────────────────────── */
.mx_SpacePanel:not(.collapsed) .mx_SpaceItem_new {
    border-top: 1px solid #ededef !important;
    margin-top: 8px !important;
    padding-top: 8px !important;
}

/* «+ Создать пространство» — иконка и текст ровно */
.mx_SpacePanel:not(.collapsed) .mx_SpaceButton_new .mx_SpaceButton_selectionWrapper {
    padding: 8px 12px !important;
}
.mx_SpacePanel:not(.collapsed) .mx_SpaceButton_new .mx_SpaceButton_name {
    overflow: visible !important;
    text-overflow: clip !important;
}

/* ─── 7. Нижние кнопки (Обсуждения / Настройки) — прижаты к низу ──────── */
.mx_SpacePanel .mx_ThreadsActivityCentreButton {
    margin-top: auto !important;
}

/* Тонкий разделитель над нижним блоком (Обсуждения/Настройки) */
.mx_SpacePanel:not(.collapsed) .mx_ThreadsActivityCentreButton {
    border-top: 1px solid #ededef !important;
    padding-top: 12px !important;
    margin-left: -12px !important;
    margin-right: -12px !important;
    padding-left: 24px !important;
    padding-right: 24px !important;
}

.mx_SpacePanel:not(.collapsed) .mx_QuickSettingsButton {
    margin-left: -12px !important;
    margin-right: -12px !important;
    padding-left: 24px !important;
    padding-right: 24px !important;
}

/* В свёрнутом виде нижние иконки тоже прижаты к низу через ThreadsActivityCentre */
.mx_SpacePanel.collapsed .mx_ThreadsActivityCentreButton,
.mx_SpacePanel.collapsed .mx_QuickSettingsButton {
    margin-left: auto !important;
    margin-right: auto !important;
}

/* ─── 8. Chevron всегда виден (а не только на hover) ────────────────────── */
.mx_SpacePanel .mx_SpacePanel_toggleCollapse,
.mx_SpacePanel .mx_SpacePanel_toggleCollapse:not(.expanded) {
    opacity: 1 !important;
}

/* В свёрнутом виде chevron смещаем под аватарку (отдельной строкой),
   чтобы не висел сбоку панели за её границей */
.mx_SpacePanel.collapsed .mx_SpacePanel_toggleCollapse {
    position: static !important;
    margin: 4px auto 8px auto !important;
    width: 24px !important;
    height: 24px !important;
    border-radius: 6px !important;
    background-color: transparent !important;
    color: #71717a !important;
}
.mx_SpacePanel.collapsed .mx_SpacePanel_toggleCollapse {
    background-color: #e4e4e7 !important;
    border-radius: 50% !important;
}
.mx_SpacePanel.collapsed .mx_SpacePanel_toggleCollapse:hover {
    background-color: #d4d4d8 !important;
}

/* ═══════════════════════════════════════════════════════════════════════════ */
/* Liquid Glass — модалки и поповеры                                           */
/* -                                                                           */
/* Заменяет тёмную rgba(0,0,0,0.6) подложку на полупрозрачный белый            */
/* с backdrop-filter: blur — frosted glass эффект как в macOS / iOS.           */
/* ═══════════════════════════════════════════════════════════════════════════ */

/* Blur только для крупных модалок (Dialog), НЕ для контекст-меню */
.mx_Dialog_background,
.mx_Dialog_background.mx_Dialog_background_overlay {
    background-color: rgb(255, 255, 255, 0.18) !important;
    backdrop-filter: blur(4px) saturate(130%) !important;
    -webkit-backdrop-filter: blur(4px) saturate(130%) !important;
    opacity: 1 !important;
}

/* Контекст-меню — прозрачный backdrop, без блюра (чтобы не размывало
   таргет-сообщение под меню реакций/ответа/закрепить и т.п.) */
.mx_ContextualMenu_background {
    background-color: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
}

/* ═══════════════════════════════════════════════════════════════════════════ */
/* Разделители между панелями и хедерами (как в оригинальном Element)         */
/* ═══════════════════════════════════════════════════════════════════════════ */

/* Вертикальные разделители колонок */
.mx_SpacePanel {
    border-right: 1px solid #ededef !important;
}
.mx_LeftPanel,
.mx_LeftPanel_outerWrapper,
.mx_RoomListPanel {
    border-right: 1px solid #ededef !important;
}
.mx_RightPanel {
    border-left: 1px solid #ededef !important;
}

/* Горизонтальные разделители: под шапкой чата, под верхней панелью поиска,
   под header-ом списка комнат */
.mx_RoomHeader {
    border-bottom: 1px solid #ededef !important;
}
.mx_RoomListSearch,
.mx_RoomListHeaderView,
[class*="RoomListHeader"] {
    border-bottom: 1px solid #ededef !important;
}

/* ─── Закреплённые сообщения: компактный двухстрочный блок ── */
.mx_PinnedMessageBanner {
    padding: 8px 16px !important;
    height: auto !important;
    min-height: 44px !important;
    background: #fafafa !important;
    border-bottom: 1px solid #ededef !important;
    box-shadow: none !important;
}

/* Preview-текст компактный: одна строка с ellipsis */
.mx_PinnedMessageBanner_message,
.mx_PinnedMessageBanner_redactedMessage {
    font-size: 13px !important;
    line-height: 18px !important;
    color: #71717a !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    max-width: 100% !important;
}

/* Title-счётчик — мельче, не доминирует */
.mx_PinnedMessageBanner_title {
    font-size: 11px !important;
    line-height: 14px !important;
    color: #a1a1aa !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
}

/* Заголовок-счётчик — компактная строка */
.mx_PinnedMessageBanner_title,
.mx_PinnedMessageBanner_title_counter {
    font-size: 12px !important;
    font-weight: 500 !important;
    color: #52525b !important;
    line-height: 20px !important;
    margin: 0 !important;
}

/* Индикаторы (палочки слева) компактнее */
.mx_PinnedMessageBanner_Indicators {
    height: 20px !important;
}

/* Пин-иконка меньше */
.mx_PinnedMessageBanner [class*="pinIcon"] svg,
.mx_PinnedMessageBanner svg {
    width: 14px !important;
    height: 14px !important;
}

/* «Посмотреть все» — компактнее */
.mx_PinnedMessageBanner_actions,
.mx_PinnedMessageBanner button {
    font-size: 12px !important;
}

/* Скрываем system-event «закрепил(а) сообщение» — дублирует banner */
.mx_EventTile_info[data-event-type="m.room.pinned_events"],
.mx_GenericEventListSummary:has([data-event-type="m.room.pinned_events"]) {
    display: none !important;
}

/* Подложка модалок не перекрывает сайдбар.
   --mx-sidebar-right выставляется JS-ом из SpacePanel.tsx адаптивно
   (реальная правая граница SpacePanel + LeftPanel при любой ширине). */
.mx_Dialog_background,
.mx_ContextualMenu_background {
    left: var(--mx-sidebar-right, 0px) !important;
    width: calc(100% - var(--mx-sidebar-right, 0px)) !important;
}

/* ═══════════════════════════════════════════════════════════════════════════ */
/* SpotlightDialog (Cmd+K / клик по «Поиск») — Linear-стиль + плавность       */
/* ═══════════════════════════════════════════════════════════════════════════ */

@keyframes mx_LinearSpotlightFadeIn {
    from {
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* Полностью гасим Compound Glass-обёртку (рендерит outline+blur+bg
   как «второй контур» вокруг диалога). Целимся и в семантический
   класс, и в Compound CSS-module хэш. */
.mx_SpotlightDialog_wrapper .mx_Dialog_border,
.mx_SpotlightDialog_wrapper [class*="_glass_"] {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
}

.mx_SpotlightDialog_wrapper .mx_Dialog {
    animation: mx_LinearSpotlightFadeIn 180ms cubic-bezier(0.16, 1, 0.3, 1) !important;
    border-radius: 20px !important;
    border: 1px solid #d4d4d8 !important;
    background-color: #ffffff !important;
    box-shadow:
        0 2px 8px rgb(0, 0, 0, 0.08),
        0 16px 40px rgb(0, 0, 0, 0.16) !important;
    padding: 0 !important;
    overflow: hidden !important;
}

.mx_SpotlightDialog {
    background-color: #ffffff !important;
}

/* Поле ввода — крупное, без рамки, с яркой подсказкой */
.mx_SpotlightDialog .mx_SpotlightDialog_searchBox,
.mx_SpotlightDialog #mx_SpotlightDialog_keyboardPrompt {
    border: none !important;
    box-shadow: none !important;
}

.mx_SpotlightDialog input[type="text"] {
    font-size: 16px !important;
    font-weight: 500 !important;
    padding: 18px 20px !important;
    border: none !important;
    background: transparent !important;
    color: #18181b !important;
}

.mx_SpotlightDialog input[type="text"]::placeholder {
    color: #a1a1aa !important;
    font-weight: 400 !important;
}

/* Подсказка с клавишами наверху */
#mx_SpotlightDialog_keyboardPrompt {
    background-color: #fafafa !important;
    border-bottom: 1px solid #ededef !important;
    padding: 10px 20px !important;
    font-size: 12px !important;
    color: #71717a !important;
}

/* Контейнер диалога — больше внутреннего воздуха */
.mx_SpotlightDialog {
    padding: 0 !important;
}

/* Заголовки секций — uppercase, мелкий серый, ровный отступ 24px */
.mx_SpotlightDialog h4 {
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    color: #a1a1aa !important;
    text-transform: uppercase !important;
    padding: 18px 24px 10px !important;
    margin: 0 !important;
}

/* «Недавно просмотренные» — увеличиваем плитки */
.mx_SpotlightDialog_recentlyViewed {
    padding: 0 16px 16px !important;
}
.mx_SpotlightDialog_recentlyViewed > div {
    gap: 8px !important;
    padding: 0 8px !important;
}
.mx_SpotlightDialog_recentlyViewed .mx_AccessibleButton {
    padding: 8px 10px !important;
    border-radius: 12px !important;
    min-width: 76px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 6px !important;
    transition: background 0.12s ease !important;
}
.mx_SpotlightDialog_recentlyViewed .mx_AccessibleButton:hover,
.mx_SpotlightDialog_recentlyViewed .mx_AccessibleButton[aria-selected="true"],
.mx_SpotlightDialog .mx_SpotlightDialog_recentlyViewed .mx_SpotlightDialog_option:hover,
.mx_SpotlightDialog .mx_SpotlightDialog_recentlyViewed .mx_SpotlightDialog_option[aria-selected="true"] {
    background-color: transparent !important;
}
.mx_SpotlightDialog_recentlyViewed .mx_BaseAvatar,
.mx_SpotlightDialog_recentlyViewed .mx_BaseAvatar img,
.mx_SpotlightDialog_recentlyViewed [class*="Avatar"] img {
    width: 44px !important;
    height: 44px !important;
    border-radius: 10px !important;
}
.mx_SpotlightDialog_recentlyViewed .mx_SpotlightDialog_recentlyViewedRoom_name,
.mx_SpotlightDialog_recentlyViewed .mx_AccessibleButton > span:last-child {
    font-size: 12px !important;
    color: #18181b !important;
    text-align: center !important;
    max-width: 70px !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
}

/* Список «Перейти к» — увеличиваем тач-таргеты */
.mx_SpotlightDialog_otherSearches > div {
    padding: 0 16px 12px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
}
.mx_SpotlightDialog_otherSearches .mx_AccessibleButton,
.mx_SpotlightDialog_otherSearches [role="option"] {
    padding: 12px 14px !important;
    border-radius: 10px !important;
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    font-size: 14px !important;
    color: #18181b !important;
    transition: background 0.12s ease !important;
}
.mx_SpotlightDialog_otherSearches .mx_AccessibleButton:hover,
.mx_SpotlightDialog_otherSearches [role="option"]:hover,
.mx_SpotlightDialog_otherSearches .mx_AccessibleButton[aria-selected="true"],
.mx_SpotlightDialog_otherSearches [role="option"][aria-selected="true"],
.mx_SpotlightDialog .mx_SpotlightDialog_otherSearches .mx_SpotlightDialog_option:hover,
.mx_SpotlightDialog .mx_SpotlightDialog_otherSearches .mx_SpotlightDialog_option[aria-selected="true"] {
    background-color: transparent !important;
}
.mx_SpotlightDialog_otherSearches svg {
    width: 20px !important;
    height: 20px !important;
    color: #71717a !important;
    flex: 0 0 20px !important;
    margin-right: 14px !important;
}

/* Высокоспецифичные правила: убираем absolute-позиционирование иконок,
   которое в дефолте перекрывает текст. */
.mx_SpotlightDialog .mx_SpotlightDialog_otherSearches .mx_SpotlightDialog_option {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    padding: 12px 16px !important;
    padding-left: 16px !important;
    border-radius: 10px !important;
    position: static !important;
}
.mx_SpotlightDialog .mx_SpotlightDialog_otherSearches .mx_SpotlightDialog_option svg,
.mx_SpotlightDialog .mx_SpotlightDialog_otherSearches .mx_SpotlightDialog_option > svg {
    position: static !important;
    transform: none !important;
    left: auto !important;
    top: auto !important;
    width: 20px !important;
    height: 20px !important;
    flex: 0 0 20px !important;
    margin: 0 !important;
    color: #71717a !important;
}
.mx_SpotlightDialog .mx_SpotlightDialog_recentlyViewed .mx_SpotlightDialog_option {
    flex-direction: column !important;
    gap: 6px !important;
    padding: 8px 10px !important;
}
.mx_SpotlightDialog .mx_SpotlightDialog_recentlyViewed .mx_SpotlightDialog_option > .mx_DecoratedRoomAvatar,
.mx_SpotlightDialog .mx_SpotlightDialog_recentlyViewed .mx_SpotlightDialog_option > .mx_BaseAvatar {
    margin: 0 !important;
    width: 44px !important;
    height: 44px !important;
}

/* Диалог — фиксированная ширина 640px, прижат к верху, авто-высота по контенту.
   Откатываем сложный flex, оставляем нормальный block-flow внутри. */
/* Центрирование диалога (как было дефолтно) */
body .mx_SpotlightDialog_wrapper {
    align-items: center !important;
    justify-content: center !important;
}
/* Высокая специфичность чтобы перебить дефолт .mx_Dialog { height: 60% !important } */
body .mx_SpotlightDialog_wrapper .mx_SpotlightDialog.mx_Dialog,
body .mx_SpotlightDialog_wrapper > .mx_Dialog,
body .mx_SpotlightDialog_wrapper .mx_Dialog {
    height: auto !important;
    max-height: 90vh !important;
    min-height: 0 !important;
    width: 640px !important;
    max-width: 90vw !important;
    overflow: visible !important;
    margin: 0 auto !important;
}
#mx_SpotlightDialog_content {
    overflow: visible !important;
    max-height: none !important;
}

/* Прячем только ↵ enter-prompt (не весь endAdornment, чтобы ::after-chevron работал) */
.mx_SpotlightDialog_enterPrompt {
    display: none !important;
}
.mx_SpotlightDialog_otherSearches .mx_SpotlightDialog_option--endAdornment {
    /* убираем дефолтный margin-left:auto чтобы не мешал нашему chevron */
    display: none !important;
}

/* Recently viewed: имя под аватаром */
.mx_SpotlightDialog_recentlyViewed .mx_DecoratedRoomAvatar,
.mx_SpotlightDialog_recentlyViewed .mx_BaseAvatar {
    margin-right: 0 !important;
    width: 44px !important;
    height: 44px !important;
}
.mx_SpotlightDialog_recentlyViewedRoom_name {
    font-size: 12px !important;
    color: #18181b !important;
    text-align: center !important;
    max-width: 70px !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    display: block !important;
}

/* Поле ввода — обведённый rounded-rect с иконкой поиска слева и esc справа */
.mx_SpotlightDialog_searchBox {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    margin: 16px 20px !important;
    padding: 0 16px !important;
    padding-right: 60px !important;
    background: #ffffff !important;
    border: 1px solid #ededef !important;
    border-radius: 12px !important;
    transition: border-color 0.12s ease, box-shadow 0.12s ease !important;
}
.mx_SpotlightDialog_searchBox:focus-within {
    border-color: #c7c7cc !important;
    box-shadow: 0 0 0 3px rgb(94, 106, 210, 0.08) !important;
}

/* Иконка лупы слева внутри поля ввода (CSS-only через mask) */
.mx_SpotlightDialog_searchBox::before {
    content: "" !important;
    width: 18px !important;
    height: 18px !important;
    flex: 0 0 18px !important;
    margin-right: 12px !important;
    background-color: #a1a1aa !important;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><path d='M21 21l-4.35-4.35'/></svg>") no-repeat center / contain !important;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><path d='M21 21l-4.35-4.35'/></svg>") no-repeat center / contain !important;
}

/* Подгоняем input под новый wrapper */
.mx_SpotlightDialog input[type="text"] {
    padding: 14px 0 !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
}

.mx_SpotlightDialog_escPill {
    position: absolute !important;
    right: 16px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    background: #f4f4f5 !important;
    color: #71717a !important;
    border-radius: 6px !important;
    padding: 3px 9px !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    font-family: ui-monospace, "SF Mono", monospace !important;
    text-transform: lowercase !important;
    line-height: 1.4 !important;
    border: 1px solid #ededef !important;
    cursor: pointer !important;
    transition: background 0.12s ease !important;
}
.mx_SpotlightDialog_escPill:hover {
    background: #e4e4e7 !important;
}

/* Chevron-right справа у фильтров «Перейти к» — SVG-стрелка через mask */
.mx_SpotlightDialog_otherSearches .mx_AccessibleButton,
.mx_SpotlightDialog_otherSearches [role="option"] {
    position: relative !important;
}
.mx_SpotlightDialog_otherSearches .mx_AccessibleButton::after,
.mx_SpotlightDialog_otherSearches [role="option"]::after {
    content: "" !important;
    position: absolute !important;
    right: 18px !important;
    top: 50% !important;
    width: 16px !important;
    height: 16px !important;
    transform: translateY(-50%) !important;
    background-color: #a1a1aa !important;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='9 18 15 12 9 6'/></svg>") no-repeat center / contain !important;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='9 18 15 12 9 6'/></svg>") no-repeat center / contain !important;
    pointer-events: none !important;
}

/* Разделители между секциями — inset 20px от краёв (как у дефолтной) */
.mx_SpotlightDialog_section + .mx_SpotlightDialog_section {
    border-top: 1px solid #ededef !important;
    margin-top: 4px !important;
}
.mx_SpotlightDialog_linearTips,
.mx_SpotlightDialog_linearSearchEverywhere {
    position: relative !important;
    border-top: none !important;
    margin-top: 4px !important;
}
.mx_SpotlightDialog_linearTips::before,
.mx_SpotlightDialog_linearSearchEverywhere::before {
    content: "" !important;
    position: absolute !important;
    top: 0 !important;
    left: 20px !important;
    right: 20px !important;
    height: 1px !important;
    background: #ededef !important;
}

/* ─── Секция «Подсказки» ─── */
.mx_SpotlightDialog_linearTips {
    padding: 4px 24px 18px !important;
}
.mx_SpotlightDialog_linearTips_title {
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
    color: #a1a1aa !important;
    text-transform: uppercase !important;
    padding: 12px 0 6px !important;
    margin: 0 !important;
}
.mx_SpotlightDialog_linearTips_row {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 6px 0 !important;
    font-size: 13px !important;
    color: #18181b !important;
}
.mx_SpotlightDialog_linearTips_keys {
    display: inline-flex !important;
    gap: 4px !important;
    min-width: 64px !important;
    align-items: center !important;
}
.mx_SpotlightDialog_linearTips kbd {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 22px !important;
    height: 22px !important;
    padding: 0 6px !important;
    background: #ffffff !important;
    border: 1px solid #ededef !important;
    border-radius: 5px !important;
    font-family: ui-monospace, "SF Mono", monospace !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    color: #52525b !important;
    box-shadow: 0 1px 0 rgb(0, 0, 0, 0.04) !important;
}

/* ─── Нижний тоггл «Искать во всём» ─── */
.mx_SpotlightDialog_linearSearchEverywhere {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 16px 20px !important;
}
.mx_SpotlightDialog_linearSearchEverywhere_label {
    display: inline-flex !important;
    align-items: center !important;
    gap: 12px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #18181b !important;
}
.mx_SpotlightDialog_linearSearchEverywhere_label svg {
    width: 18px !important;
    height: 18px !important;
    color: #71717a !important;
}

/* Toggle switch */
.mx_SpotlightDialog_linearToggle {
    position: relative !important;
    display: inline-block !important;
    width: 36px !important;
    height: 20px !important;
    cursor: pointer !important;
}
.mx_SpotlightDialog_linearToggle input {
    opacity: 0 !important;
    width: 0 !important;
    height: 0 !important;
}
.mx_SpotlightDialog_linearToggle span {
    position: absolute !important;
    inset: 0 !important;
    background: #e4e4e7 !important;
    border-radius: 999px !important;
    transition: background 0.18s ease !important;
}
.mx_SpotlightDialog_linearToggle span::before {
    content: "" !important;
    position: absolute !important;
    width: 16px !important;
    height: 16px !important;
    left: 2px !important;
    top: 2px !important;
    background: #ffffff !important;
    border-radius: 50% !important;
    transition: transform 0.18s ease !important;
    box-shadow: 0 1px 2px rgb(0, 0, 0, 0.15) !important;
}
.mx_SpotlightDialog_linearToggle input:checked + span {
    background: #5e6ad2 !important;
}
.mx_SpotlightDialog_linearToggle input:checked + span::before {
    transform: translateX(16px) !important;
}

/* Скрываем дефолтный hidden a11y keyboardPrompt — у нас своя видимая секция */
#mx_SpotlightDialog_keyboardPrompt {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip-path: inset(50%) !important;
    border: 0 !important;
}

/* Подложка спотлайта — покрывает весь экран с лёгким затемнением и blur.
   Сайдбар остаётся резким благодаря z-index: 4001 (выше overlay). */
.mx_SpotlightDialog_wrapper .mx_Dialog_background {
    background-color: rgb(24, 24, 27, 0.20) !important;
    backdrop-filter: blur(6px) saturate(140%) !important;
    -webkit-backdrop-filter: blur(6px) saturate(140%) !important;
    left: 0 !important;
    width: 100% !important;
}

/* Сама модалка — мягкая тень + лёгкий стеклянный фон сверху */
.mx_Dialog {
    background-color: rgb(255, 255, 255, 0.98) !important;
    border-radius: 16px !important;
    box-shadow:
        0 1px 2px rgb(0, 0, 0, 0.04),
        0 10px 40px rgb(0, 0, 0, 0.08),
        0 0 0 1px rgb(255, 255, 255, 0.6) inset !important;
}
